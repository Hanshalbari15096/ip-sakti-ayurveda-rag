# ============================================================
# IP-SAKTI Ayurveda IPR Assistant - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
# ============================================================

# Gemini API Key (recommended - fast model)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=

# Groq API Key (LLM answers + free fast Whisper speech-to-text)
# Get yours at: https://console.groq.com/
GROQ_API_KEY=

# Whisper model for STT: whisper-large-v3 (most accurate) or
# whisper-large-v3-turbo (faster, slightly less accurate)
# GROQ_STT_MODEL=whisper-large-v3

# Sarvam AI API Configuration (for high-quality Hindi/Indic speech-to-text
# and Bulbul text-to-speech). Get yours at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# Bhashini API Configuration (national-language infrastructure; used for
# query translation / transliteration in the multilingual pipeline).
# Get yours at: https://bhashini.gov.in/
BHASHINI_AUTH_TOKEN=
BHASHINI_BASE_URL=https://api.bhashini.gov.in

# Optional: custom OpenAI-compatible LLM endpoint (local/remote).
# Set BOTH to enable it.
# LLM_BASE_URL=
# LLM_API_KEY=

# ============================================================
# Optional: Override defaults
# ============================================================
# COLLECTION_NAME=my_knowledge
# CHUNK_SIZE=500
# TOP_K=8
# MODEL=gemini-2.5-flash